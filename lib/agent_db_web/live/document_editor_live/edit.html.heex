<div class="min-h-screen bg-gray-50">
  <header class="bg-white shadow-sm border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center h-16">
        <div class="flex items-center space-x-4">
          <a href="/admin" class="text-sm text-gray-500 hover:text-gray-700">← Back to Admin</a>
          <h1 class="text-xl font-semibold text-gray-900">Edit Document</h1>
        </div>
        <div class="flex items-center space-x-3">
          <span class={["px-2 py-1 rounded text-xs font-medium", if(@saved), do: "bg-green-100 text-green-700", else: "bg-yellow-100 text-yellow-700"]}>
            <%= if(@saved), do: "Saved", else: "Unsaved changes" %>
          </span>
        </div>
      </div>
    </div>
  </header>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <%= live_flash(@flash) %>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Editor Pane -->
      <div class="lg:col-span-2">
        <div class="editor-pane rounded-lg shadow-sm border border-gray-200">
          <header class="border-b border-gray-200">
            <code class="text-sm font-mono text-gray-700 px-4 py-2 block"><%= @uri %></code>
          </header>
          <form phx-submit="publish" phx-change="save_draft">
            <textarea 
              name="content"
              value={@draft}
              class="w-full h-96 p-4 font-mono text-sm border-none focus:outline-none resize-none"
              placeholder="Start writing..."
              phx-hook="AutoSave"
            ></textarea>
            <div class="p-4 border-t border-gray-200 flex justify-end space-x-3">
              <a href="/admin" class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50">Cancel</a>
              <button type="submit" class="px-4 py-2 text-sm font-medium text-white bg-blue-600 border border-transparent rounded-lg hover:bg-blue-700">Publish</button>
            </div>
          </form>
        </div>
      </div>

      <!-- Sidebar with Abstract/Overview -->
      <div class="space-y-4">
        <div class="editor-pane rounded-lg shadow-sm border border-gray-200">
          <header>Abstract</header>
          <pre class="whitespace-pre-wrap"><%= @abstract %></pre>
        </div>

        <div class="editor-pane rounded-lg shadow-sm border border-gray-200">
          <header>Overview</header>
          <pre class="whitespace-pre-wrap"><%= @overview %></pre>
        </div>

        <div class="editor-pane rounded-lg shadow-sm border border-gray-200">
          <header>Actions</header>
          <div class="p-4 space-y-2">
            <button 
              phx-click="regenerate_abstract"
              class="w-full px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50">
              Regenerate Abstract
            </button>
            <button 
              phx-click="regenerate_overview"
              class="w-full px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50">
              Regenerate Overview
            </button>
            <button 
              phx-click="delete_document"
              class="w-full px-4 py-2 text-sm font-medium text-red-600 bg-white border border-red-300 rounded-lg hover:bg-red-50">
              Delete Document
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>